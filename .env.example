# Agentic UG Demo —— 环境变量示例
# 复制为 .env 本地使用；生产由 k8s Secret/ConfigMap 注入。
# 禁止把真实密钥提交进 git。

# ── PostgreSQL（dataserver + dashboard 共用同一库）──
# 优先使用完整 DSN；或用分量变量（与 dora-k8s-config features.databases 对齐）。
DATABASE_URL=
# DATABASE_HOST=localhost
# DATABASE_PORT=5432
# DATABASE_USERNAME=agentic_ug
# DATABASE_PASSWORD=changeme
# DATABASE_NAME=agentic_ug
DB_POOL_MIN=2
DB_POOL_MAX=10

# ── dataserver（FastAPI, 端口 5000）──
QUEUE_MAXSIZE=20000
BATCH_SIZE=500
FLUSH_INTERVAL=1.0
ALERT_LOCK_DIR=/tmp/agentic-ug-alert-locks

# ── dashboard（Express, 端口 8081）──
DASHBOARD_PORT=8081
# 历史 M2M 兼容口令；网页账号由 dashboard_user 表管理。
DASHBOARD_ADMIN_PASS=
# 历史飞书回调基址，当前登录入口已停用；飞书资料仍供部分权限逻辑兼容使用。
APP_BASE_URL=https://ug-data-callback.sitinai.com

# ── sitin.ai 客户门户（/demo，独立于主站账号鉴权）──
# 门户账号现存数据库表 demo_portal_user（明文口令，服务端校验），不再走环境变量。
# migrate 会自动建表并种默认账号：用户名 sitin / 口令 aifantasy。
# 加账号 / 改口令直接改表即可，例如：
#   INSERT INTO demo_portal_user (username, password, company) VALUES ('客户名','口令','公司');

# ── XMP Open API ──
XMP_CLIENT_ID=
XMP_CLIENT_SECRET=
XMP_API_HOST=xmp-open.mobvista.com

# ── 雅典娜收入 API ──
ATHENA_API_URL=https://admin-api-prod.sitin.ai/api/open/admin/revenue
ATHENA_API_KEY=

# ── LLM（SiliconFlow GLM）──
SILICONFLOW_API_KEY=
SILICONFLOW_BASE_URL=https://api.siliconflow.com/v1
LLM_MODEL=zai-org/GLM-5.1

# ── 飞书/Lark（脚本用）──
FEISHU_APP_ID=
FEISHU_APP_SECRET=
LARK_APP_SECRET=

# ── DAU 服务（脚本用）──
DAU_BASE=http://62.234.39.191:8765
DAU_PASS=

# ── Facebook Marketing API（投放平台 Demo）──
FB_LONG_TOKEN=
FB_AD_ACCOUNT_ID=
FB_APP_ID=
FB_APP_SECRET=
