{
  "name": "agentic-ug-demo",
  "version": "0.0.0",
  "private": true,
  "description": "Sitin 投放数据平台（Next.js + Node CLI，统一 PostgreSQL）",
  "type": "module",
  "packageManager": "pnpm@11.7.0",
  "engines": {
    "node": ">=22 <23"
  },
  "scripts": {
    "build": "pnpm -r build",
    "start": "pnpm --filter @agentic-ug/web start",
    "job:fetch": "pnpm --filter @agentic-ug/scheduler start",
    "job:ingest": "pnpm --filter @agentic-ug/ingest-worker start",
    "job:tag-payment-channel": "pnpm --filter @agentic-ug/tag-payment-channel start",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@types/node": "^22.10.5",
    "eslint": "^9.17.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-import": "^2.31.0",
    "eslint-plugin-unicorn": "^56.0.1",
    "prettier": "^3.4.2",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.19.1"
  }
}
